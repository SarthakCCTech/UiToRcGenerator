<Window x:Class="UiToRcGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UiToRcGenerator"
        mc:Ignorable="d"
        Title="UI-to-RC Resource Generator" 
        Height="680" Width="980"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Full Width Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Control Bar (Clean, Minimal, Non-Flashy) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <!-- Left: Start/Stop Button & Prefix -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleCapture" Click="BtnToggleCapture_Click" 
                            Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtToggleBtnIcon" Text="▶ " FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtToggleBtnText" Text="Start Direct UIA Hover" FontSize="12" FontWeight="SemiBold"/>
                            <Border Background="#25FFFFFF" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                <TextBlock Text="Ctrl + Shift + H" FontSize="10" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                    <TextBlock Text="Prefix:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="#4B5563"/>
                    <TextBox x:Name="TxtIdPrefix" Text="IDS_UI_" Width="80" VerticalAlignment="Center" Margin="0,0,6,0" Padding="4,2"/>
                    <Button Content="Re-assign IDs" Click="BtnReassignIds_Click" Padding="6,3" FontSize="11"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                    <CheckBox x:Name="ChkAutoDeduplicate" Content="Auto-Deduplicate" IsChecked="True" 
                              VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                              ToolTip="Ignore duplicate string captures when hovering on the same control multiple times"/>
                </StackPanel>

                <!-- Right: Hotkey Reminder & String Count -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                        <TextBlock Text="Hotkey: Ctrl+Shift+H or F8" FontSize="11" Foreground="#6B7280"/>
                    </Border>

                    <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="TxtItemCountBadge" Text="0 Strings" FontWeight="Bold" Foreground="#1F2937" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Full Width Workspace Tabs (No Black Split Screen) -->
        <TabControl x:Name="MainTabs" Grid.Row="1" BorderBrush="#E5E7EB" Background="#FFFFFF">
            <!-- Tab 1: Captured UI Strings -->
            <TabItem Header="Captured UI Strings">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Action Bar -->
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ Add String" Click="BtnAddString_Click" Padding="6,3" FontSize="11"/>
                                <Button Content="❌ Delete" Click="BtnDeleteSelected_Click" Padding="6,3" FontSize="11" Foreground="#B91C1C"/>
                                <Button Content="🔗 Merge with Next" Click="BtnMergeNext_Click" Padding="6,3" FontSize="11"/>
                                <Button Content="✂️ Split Line" Click="BtnSplitLine_Click" Padding="6,3" FontSize="11"/>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0"/>

                                <Button Content="▲ Move Up" Click="BtnMoveUp_Click" Padding="6,3" FontSize="11"/>
                                <Button Content="▼ Move Down" Click="BtnMoveDown_Click" Padding="6,3" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="🗑️ Clear All" Click="BtnClearAll_Click" Padding="6,3" FontSize="11" Foreground="#B91C1C"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Clean Full-Width DataGrid -->
                    <DataGrid x:Name="DgExtractedItems" Grid.Row="1" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" HeadersVisibility="Column"
                              BorderBrush="#E5E7EB" RowHeaderWidth="0"
                              FontSize="12" FontFamily="Segoe UI"
                              CellEditEnding="DgExtractedItems_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" IsReadOnly="True" Width="40"/>
                            <DataGridTextColumn Header="Resource ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                            <DataGridTextColumn Header="String Value (UI Text)" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Control Type" Binding="{Binding ControlType}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Bounding Box" Binding="{Binding BoundingBoxDisplay}" IsReadOnly="True" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Visual C++ .rc Generator -->
            <TabItem Header="Visual C++ .rc Generator">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Template Options -->
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Resource Script Configuration:" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"/>
                            <RadioButton x:Name="RbPreserveReference" Content="Merge into reference template (2dTransRes.rc)" IsChecked="True" Checked="RcOption_Changed" FontSize="12"/>
                            <RadioButton x:Name="RbStandaloneRc" Content="Generate clean standalone .rc file" Margin="0,3,0,0" Checked="RcOption_Changed" FontSize="12"/>

                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Reference Path:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                <Button DockPanel.Dock="Right" Content="Browse..." Click="BtnBrowseReference_Click" Padding="6,2" Margin="6,0,0,0" FontSize="11"/>
                                <TextBox x:Name="TxtReferencePath" Text="2dTransRes.rc" VerticalAlignment="Center" Padding="4,2"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Validation Banner -->
                    <Border x:Name="ValidationBanner" Grid.Row="1" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock x:Name="TxtValidationStatus" Text="Ready to generate .rc output" Foreground="#166534" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                            <Button DockPanel.Dock="Right" Content="Validate Syntax" Click="BtnValidateSyntax_Click" Padding="6,2" FontSize="11"/>
                        </DockPanel>
                    </Border>

                    <!-- RC Code Preview (Monospace) -->
                    <TextBox x:Name="TxtRcPreview" Grid.Row="2" FontFamily="Consolas" FontSize="11"
                             AcceptsReturn="True" AcceptsTab="True"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             IsReadOnly="False" Background="#1E1E1E" Foreground="#D4D4D4"
                             Padding="8" BorderThickness="1" BorderBrush="#333333"/>

                    <!-- Action Buttons -->
                    <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                        <Button Content="🔄 Refresh Preview" Click="BtnRefreshRc_Click" Padding="10,5"/>
                        <Button Content="📋 Copy to Clipboard" Click="BtnCopyRc_Click" Padding="10,5" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="💾 Save As .rc File..." Click="BtnSaveRc_Click" 
                                Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8" Padding="14,5"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="-12,6,-12,-12" Padding="10,4">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Ready. Press 'Start Direct UIA Hover' or press Ctrl+Shift+H from any window." FontSize="11" Foreground="#4B5563"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtEngineInfo" Text="Direct Windows UI Automation Engine" FontSize="11" Foreground="#6B7280"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
