<Window x:Class="UiToRcGenerator.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#2B000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">
    <Canvas x:Name="OverlayCanvas">
        <!-- Instructional Banner -->
        <Border Background="#CC1E1E1E" CornerRadius="6" Padding="14,8"
                Canvas.Left="20" Canvas.Top="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯 Drag to select desktop region" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="  |  Press Esc to Cancel" Foreground="#CCCCCC" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Selection Rubber-band Rectangle -->
        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="#0078D7"
                   StrokeThickness="2"
                   StrokeDashArray="3 1"
                   Fill="#260078D7"/>

        <!-- Dimension Tooltip -->
        <Border x:Name="DimensionBadge"
                Visibility="Collapsed"
                Background="#EE000000"
                CornerRadius="4"
                Padding="6,3">
            <TextBlock x:Name="DimensionText"
                       Foreground="#FFFFFF"
                       FontSize="11"
                       FontFamily="Segoe UI"/>
        </Border>
    </Canvas>
</Window>
