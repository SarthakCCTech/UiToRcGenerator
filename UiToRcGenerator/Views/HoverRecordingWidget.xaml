<Window x:Class="UiToRcGenerator.Views.HoverRecordingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Height="50" Width="440"
        MouseDown="Window_MouseDown"
        Cursor="SizeAll">

    <Grid Margin="3">
        <!-- Floating Recording Pill -->
        <Border Background="#F51E2229" BorderBrush="#475569" BorderThickness="1.2" CornerRadius="20" Padding="12,5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <DockPanel LastChildFill="True">
                <!-- Stop Button on Right -->
                <Button x:Name="BtnStop" DockPanel.Dock="Right" Click="BtnStop_Click" Cursor="Hand"
                        Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                        FontWeight="Bold" FontSize="11" Padding="10,4" Margin="6,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏹ Stop" Margin="0,0,3,0"/>
                        <TextBlock Text="(Ctrl+Shift+H)" FontSize="9" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Recording Status Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Red Indicator Dot -->
                    <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>

                    <TextBlock Text="REC" Foreground="#EF4444" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Border Background="#334155" CornerRadius="8" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtCount" Text="0 Strings" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="11" FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Last String Preview -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="6,2" MaxWidth="150">
                        <TextBlock x:Name="TxtLastString" Text="Hover over button..." Foreground="#CBD5E1" FontSize="10" FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
